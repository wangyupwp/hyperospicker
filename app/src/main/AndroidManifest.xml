<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cn.wangyupwp.hyperospicker">
    <queries>
        <package android:name="com.android.photopicker" />
        <package android:name="com.android.fileexplorer" />
    </queries>
    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/module_icon"
        android:label="@string/app_name"
        android:theme="@style/ModuleTheme">
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity android:name=".LogActivity" android:exported="false" />
        <provider
            android:name=".LogProvider"
            android:authorities="cn.wangyupwp.hyperospicker.events"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
